// --- Helpers ---
const normalize = (s) =>
  (s || "")
    .replace(/\s+/g, " ")
    .replace(/[“”]/g, '"')
    .replace(/[‘’]/g, "'")
    .trim();

const tokenize = (s) =>
  normalize(s)
    .toLowerCase()
    .replace(/[^a-z0-9\s']/g, " ")
    .split(/\s+/)
    .filter(Boolean);

const ngrams = (tokens, n = 3) => {
  const out = [];
  for (let i = 0; i <= tokens.length - n; i++) {
    out.push(tokens.slice(i, i + n).join(" "));
  }
  return out;
};

const sentenceSplit = (text) => {
  const t = normalize(text);
  if (!t) return [];
  // Basic sentence split (good enough for class practice)
  const parts = t
    .replace(/\n+/g, " ")
    .split(/(?<=[.!?])\s+(?=[A-Z0-9"'])/)
    .map((p) => p.trim())
    .filter(Boolean);
  return parts.length ? parts : [t];
};

function countWords(text) {
  return tokenize(text).length;
}

function percent(n) {
  return Math.max(0, Math.min(100, Math.round(n)));
}

function buildNgramMatchData(source, draft, n = 3) {
  const st = tokenize(source);
  const dt = tokenize(draft);
  const sset = new Set(ngrams(st, n));
  const dgrams = ngrams(dt, n);
  let hits = 0;
  for (const g of dgrams) if (sset.has(g)) hits++;
  const hitRate = dgrams.length ? hits / dgrams.length : 0;
  return { hits, total: dgrams.length, hitRate };
}

function highlightLongExactPhrases(source, draft, minWords = 3) {
  // Highlights repeated minWords-or-more exact sequences (simple, transparent)
  const srcTokens = tokenize(source);
  const drTokens = tokenize(draft);
  if (!srcTokens.length || !drTokens.length) return [];

  // Build a set of source ngrams for n = minWords
  const srcN = new Set(ngrams(srcTokens, minWords));

  // Find starting indices in draft where a minWords ngram matches
  const matches = [];
  for (let i = 0; i <= drTokens.length - minWords; i++) {
    const g = drTokens.slice(i, i + minWords).join(" ");
    if (srcN.has(g)) {
      // Extend match as long as it keeps matching a source sequence
      let j = i + minWords;
      while (j < drTokens.length) {
        const extended = drTokens.slice(i, j + 1).join(" ");
        // Check if extended appears in source as a contiguous phrase
        // (slow but fine for small classroom text)
        const extendedStr = " " + srcTokens.join(" ") + " ";
        if (extendedStr.includes(" " + extended + " ")) {
          j++;
        } else {
          break;
        }
      }
      const end = j; // exclusive
      matches.push({ start: i, end });
      i = end - 1; // skip ahead
    }
  }
  // Merge overlaps
  matches.sort((a, b) => a.start - b.start);
  const merged = [];
  for (const m of matches) {
    const last = merged[merged.length - 1];
    if (!last || m.start > last.end) merged.push({ ...m });
    else last.end = Math.max(last.end, m.end);
  }
  return merged;
}

function renderTokenHighlights(draft, ranges) {
  const tokens = tokenize(draft);
  if (!tokens.length) return <span className="text-muted-foreground">(nothing yet)</span>;
  const marks = new Array(tokens.length).fill(false);
  for (const r of ranges) {
    for (let i = r.start; i < r.end && i < marks.length; i++) marks[i] = true;
  }

  // Rebuild into readable-ish chunks; this is a practice visual, not perfect punctuation.
  const out = [];
  let i = 0;
  while (i < tokens.length) {
    const isMarked = marks[i];
    let j = i;
    while (j < tokens.length && marks[j] === isMarked) j++;
    const chunk = tokens.slice(i, j).join(" ");
    out.push(
      isMarked ? (
        <mark key={i} className="rounded px-1 py-0.5">
          {chunk}
        </mark>
      ) : (
        <span key={i}>{chunk}</span>
      )
    );
    out.push(<span key={`sp-${i}`}> </span>);
    i = j;
  }
  return <span className="leading-7">{out}</span>;
}

